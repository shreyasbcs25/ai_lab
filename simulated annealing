import math
import random

def cost(state):
    """Calculates attacking pairs of queens."""
    return sum(
        state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j)
        for i in range(8)
        for j in range(i + 1, 8)
    )

def print_board(state):
    """Prints the 8x8 grid."""
    for row in range(8):
        print(" ".join("Q" if state[col] == row else "." for col in range(8)))

def simulated_annealing():
    current_state = [random.randint(0, 7) for _ in range(8)]
    current_cost = cost(current_state)
    temp = 1000.0
    cooling_rate = 0.99
    min_temp = 0.001

    while temp > min_temp and current_cost > 0:
        col = random.randint(0, 7)
        new_row = random.randint(0, 7)
        
        neighbor = list(current_state)
        neighbor[col] = new_row
        neighbor_cost = cost(neighbor)

        delta_e = current_cost - neighbor_cost

        # Move if better, or with probability e^(delta_e / T) if worse
        if delta_e > 0 or random.random() < math.exp(delta_e / temp):
            current_state = neighbor
            current_cost = neighbor_cost

        temp *= cooling_rate

    print(f"Goal State: {current_state} | Cost: {current_cost}\n")
    print("Final Board Configuration:")
    print_board(current_state)

if __name__ == "__main__":
    simulated_annealing()
