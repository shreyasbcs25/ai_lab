def print_grid(state):
    """Prints the 9-item list as a 3x3 visual board."""
    for i in range(0, 9, 3):
        row = [str(x) if x != 0 else "_" for x in state[i:i+3]]
        print("  ".join(row))
    print()

def solve_puzzle_with_metrics(start, goal, limit=20):
    stack = [(start, [])]
    seen = {tuple(start): 0}
    
    
    total_nodes_generated = 1
    max_memory_nodes = 1
    
    
    moves = {
        0: [(1, 'Right'), (3, 'Down')],
        1: [(-1, 'Left'), (1, 'Right'), (3, 'Down')],
        2: [(-1, 'Left'), (3, 'Down')],
        3: [(-3, 'Up'), (1, 'Right'), (3, 'Down')],
        4: [(-3, 'Up'), (-1, 'Left'), (1, 'Right'), (3, 'Down')],
        5: [(-3, 'Up'), (-1, 'Left'), (3, 'Down')],
        6: [(-3, 'Up'), (1, 'Right')],
        7: [(-3, 'Up'), (-1, 'Left'), (1, 'Right')],
        8: [(-3, 'Up'), (-1, 'Left')]
    }
    
    
    history = {tuple(start): [start]}

    while stack:
        curr, path = stack.pop()
        
        if curr == goal:
            return path, history[tuple(curr)], total_nodes_generated, max_memory_nodes
            
        if len(path) >= limit:
            continue
            
        idx = curr.index(0)
        for d, name in moves[idx]:
            nxt = list(curr)
            nxt[idx], nxt[idx + d] = nxt[idx + d], nxt[idx]
            t_nxt = tuple(nxt)
            
            total_nodes_generated += 1
            
            if t_nxt not in seen or len(path) + 1 < seen[t_nxt]:
                seen[t_nxt] = len(path) + 1
                history[t_nxt] = history[tuple(curr)] + [nxt]
                stack.append((nxt, path + [name]))
                
        
        max_memory_nodes = max(max_memory_nodes, len(stack) + len(seen))
                
    return None, [], total_nodes_generated, max_memory_nodes


initial_state = [1, 2, 3, 0, 4, 6, 7, 5, 8]
goal_state    = [1, 2, 3, 4, 5, 6, 7, 8, 0]



path, grid_history, total_nodes, max_nodes = solve_puzzle_with_metrics(initial_state, goal_state)

if path is not None:
    
    for step, grid in enumerate(grid_history):
        if step == 0:
            print("Initial Board State:")
        else:
            print(f"Step {step} (Moved {path[step-1]}):")
        print_grid(grid)
        
  
    print(f"Path Cost (Total moves): {len(path)}")
    print(f"Time Complexity : {total_nodes}")
    print(f"Space Complexity : {max_nodes}")
else:
    print("No solution found within the specified depth limit.")

