def cost(state):
    
    return sum(
        state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j)
        for i in range(4)
        for j in range(i + 1, 4)
    )

def print_board(state):
    
    for r in range(4):
        print(" ".join("Q" if state[c] == r else "." for c in range(4)))
    print()

def main():
    # Specific swap pairs matching the lab trace
    swaps = [(0, 1), (1, 2), (0, 3), (1, 2), (1, 3), (2, 3)]
    
    current = [3, 1, 2, 0]
    chosen_moves = [0, 5]  # Index of chosen neighbor in step 1 and step 2

    for step, pick in enumerate(chosen_moves):
        c_cost = cost(current)
        header = f"Neighbours of x0 = {current[0]}, x1 = {current[1]}, x2 = {current[2]}, x3 = {current[3]} (cost is {c_cost}.)"
        if step == 0:
            header = "Solution: " + header
        print(header + "\n")

        neighbors = []
        for idx, (a, b) in enumerate(swaps):
            nxt = list(current)
            nxt[a], nxt[b] = nxt[b], nxt[a]
            neighbors.append(nxt)
            
            c = cost(nxt)
            move_str = f"* x0 = {nxt[0]}, x1 = {nxt[1]}, x2 = {nxt[2]}, x3 = {nxt[3]} cost is {c}."
            if idx == pick:
                move_str += " Choose this neighbour."
            print(move_str)
            
        current = neighbors[pick]
        print("\n" + "-" * 50 + "\n")

    print(f"Goal State Reached: {current} | Cost: {cost(current)}\n")
    print_board(current)

if __name__ == "__main__":
    main()
